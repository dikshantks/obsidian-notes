# MySQL server configuration for Flink CDC (Debezium-based MySQL connector).
#
# The MySQL CDC connector reads the binary log ("binlog"). MySQL 8 ships with
# the binlog enabled by default, but the connector has strict requirements on
# HOW it is written, so we set them explicitly rather than relying on defaults.
[mysqld]
# Every server in a replication topology (and each CDC client counts) needs a
# unique server-id. This is the *database's* id; Flink uses its own range.
server-id            = 223344

# Enable the binary log and give the log files a stable prefix.
log-bin              = mysql-bin

# Flink CDC / Debezium require ROW-based logging: statement-based logging does
# not capture the actual before/after row images the connector needs.
binlog-format        = ROW

# FULL row image writes every column for every change (not just changed ones),
# which the connector relies on to build complete change events.
binlog-row-image     = FULL

# Keep binlogs for a week so a restarted Flink job can resume from its offset.
binlog-expire-logs-seconds = 604800

# GTIDs make CDC offset tracking more robust across restarts/failovers.
gtid-mode                 = ON
enforce-gtid-consistency  = ON

# Reasonable defaults for a local demo.
default-authentication-plugin = mysql_native_password
