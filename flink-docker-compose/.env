# ---------------------------------------------------------------------------
# Central place for image versions and credentials used by docker-compose.yml.
# Edit here to bump versions in one spot. Values are NOT secrets — this is a
# local demo; do not reuse these credentials anywhere real.
# ---------------------------------------------------------------------------

# --- Image versions (all multi-arch: amd64 + arm64) ------------------------
MYSQL_VERSION=8.0
FLINK_VERSION=2.2.1-java21
NESSIE_VERSION=0.108.1
TRINO_VERSION=482
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MC_VERSION=RELEASE.2025-04-16T18-13-26Z

# --- Connector versions (baked into the Flink image; see flink/Dockerfile) -
ICEBERG_VERSION=1.11.0
# Iceberg's Flink module lags one minor behind: 2.1 module works on Flink 2.2.
ICEBERG_FLINK_MINOR=2.1
# FLINK_MINOR is used as the Flink-version suffix in CDC artifact names (3.6.0-2.2).
FLINK_MINOR=2.2
MYSQL_CDC_VERSION=3.6.0-2.2
MYSQL_DRIVER_VERSION=8.4.0
FLINK_CDC_VERSION=3.6.0

# --- MySQL credentials ------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=inventory

# --- MinIO / S3 credentials (shared by Nessie, Flink and Trino) ------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
WAREHOUSE_BUCKET=warehouse
